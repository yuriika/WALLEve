@inject WALLEve.Services.Market.Interfaces.IInventoryService InventoryService
@inject WALLEve.Services.Authentication.Interfaces.IEveAuthenticationService AuthService
@inject WALLEve.Services.Market.Interfaces.IMarketDataService MarketDataService
@inject WALLEve.Services.Holdings.Interfaces.IHoldingsAggregateService HoldingsService
@inject ILogger<InventoryView> Logger
@using WALLEve.Models.Wallet
@using WALLEve.Models.Database
@using WALLEve.Models.Holdings
@using WALLEve.Services.Market.Interfaces

@if (_isLoading)
{
    <div class="loading"><div class="spinner"></div><p>Lade Inventar und Marktdaten (ESI)...</p></div>
}
else if (_errorMessage != null)
{
    <div class="error-banner">@_errorMessage</div>
}
else if (_items.Any())
{
    <div class="portfolio-card">
        <div class="portfolio-stats">
            <div class="p-stat"><span class="p-label">Item-Typen</span><span class="p-value">@_overview?.TotalItemTypes</span></div>
            <div class="p-stat"><span class="p-label">Gesamtmenge</span><span class="p-value">@_overview?.TotalQuantity.ToString("N0")</span></div>
            <div class="p-stat"><span class="p-label">Marktwert</span><span class="p-value isk">@((_overview?.TotalMarketValue ?? 0).FormatIsk()) ISK</span></div>
            <div class="p-stat"><span class="p-label">Cost Basis</span><span class="p-value">@((_overview?.ItemCountWithCostBasis ?? 0)) / @(_overview?.TotalItemTypes ?? 0)</span></div>
        </div>
        <div class="rec-bar">
            <span class="rec rec-sell">🟢 Verkaufen: @_overview?.SellRecommendations</span>
            <span class="rec rec-watch">🟡 Beobachten: @_overview?.WatchRecommendations</span>
            <span class="rec rec-hold">🔴 Halten: @_overview?.HoldRecommendations</span>
        </div>
    </div>

    @if (_holdingsTree != null)
    {
        <div class="holdings-panel">
            <div class="holdings-head">
                <button class="sort-btn @(_showTree ? "active" : "")" @onclick="() => _showTree = !_showTree"
                        title="Aggregierte Sicht auf den neuesten abgeschlossenen Holdings-Snapshot (Type-/Type-Location-Projektionen und Ortsbaum mit Drill-down auf Rohzeilen).">
                    🌳 Ortsbaum & Aggregate
                </button>
                <span class="holdings-meta" title="Qualität: aufgelöste vs. unbekannte Location-Zeilen des Snapshots. Unbekannte Orte sind separat sichtbar und vermischen sich nie mit aufgelösten.">
                    Snapshot @_holdingsTree.SyncedAt.ToString("g") · <span class="@(_holdingsTree.IsFresh ? "qual-fresh" : "qual-stale")">@(_holdingsTree.IsFresh ? "frisch" : "älter als 24 h")</span>
                    · @_holdingsTree.ResolvedItemCount/@_holdingsTree.RawItemCount Locations aufgelöst · gesamt x @_holdingsTree.TotalQuantity.ToString("N0")
                </span>
            </div>

            @if (_showTree)
            {
                <div class="agg-section">
                    <div class="dlabel">Nach Item-Typ (@_holdingsTree.TypeAggregates.Count)</div>
                    @foreach (var agg in _holdingsTree.TypeAggregates)
                    {
                        <div class="agg-row" @onclick="() => ToggleTypeAgg(agg.TypeId)"
                             title="@($"{agg.ResolvedLocationItemCount}/{agg.RawItemCount} Zeilen mit aufgelöster Location; {agg.UnknownLocationItemCount} unbekannt")">
                            <span class="tree-indent"></span>
                            <span class="tree-chevron">@(agg.Locations.Count > 0 ? (_expandedTypeAggs.Contains(agg.TypeId) ? "▾" : "▸") : "·")</span>
                            <span class="agg-name">@(agg.TypeName ?? $"Type {agg.TypeId}")</span>
                            <span class="agg-qty">x @agg.TotalQuantity.ToString("N0")</span>
                            <span class="agg-sub">@agg.RawItemCount Zeilen</span>
                            @if (agg.UnknownLocationItemCount > 0)
                            {
                                <span class="loc-blocked" title="Zeilen mit unbekannter Location — separat ausgewiesen">@agg.UnknownLocationItemCount unbekannt</span>
                            }
                            else
                            {
                                <span class="qual-fresh">alle Orte aufgelöst</span>
                            }
                        </div>
                        @if (_expandedTypeAggs.Contains(agg.TypeId))
                        {
                            <div class="agg-detail">
                                @foreach (var loc in agg.Locations)
                                {
                                    <div class="loc-row" style="padding-left: 2rem">
                                        <span class="loc-name" title="Kette: @string.Join(" → ", loc.ChainLocationIds)">
                                            📍 @(loc.Name ?? $"Location {loc.LocationId}")@(loc.SolarSystemName != null ? $" ({loc.SolarSystemName})" : "")
                                        </span>
                                        <span class="loc-qty">x @loc.Quantity.ToString("N0")</span>
                                        @if (!loc.IsResolved)
                                        {
                                            <span class="loc-blocked" title="@loc.UnresolvedReason">unaufgelöst</span>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>

                <div class="agg-section">
                    <div class="dlabel">Ortsbaum (@_holdingsTree.LocationTrees.Count Wurzeln)</div>
                    @foreach (var root in _holdingsTree.LocationTrees)
                    {
                        <HoldingsLocationNodeView Node="root" Depth="0" />
                    }
                    @if (_holdingsTree.UnknownLocations != null)
                    {
                        <div class="tree-unknown">
                            <div class="agg-row" @onclick="() => ToggleNode(_holdingsTree.UnknownLocations!.LocationId)">
                                <span class="tree-indent"></span>
                                <span class="tree-chevron">▸</span>
                                <span class="agg-name">❓ @_holdingsTree.UnknownLocations.Name</span>
                                <span class="agg-qty">x @_holdingsTree.UnknownLocations.Quantity.ToString("N0")</span>
                                <span class="agg-sub">@_holdingsTree.UnknownLocations.RawItemCount</span>
                            </div>
                            @if (_expandedNodes.Contains(_holdingsTree.UnknownLocations.LocationId))
                            {
                                @foreach (var child in _holdingsTree.UnknownLocations.Children)
                                {
                                    <HoldingsLocationNodeView Node="child" Depth="1" />
                                }
                            }
                        </div>
                    }
                </div>
            }
        </div>
    }

    <div class="sort-controls">
        <div class="sort-buttons">
            <button class="sort-btn @(_sortMode == SortMode.Opportunity ? "active" : "")"
                    @onclick="() => SetSort(SortMode.Opportunity)"
                    title="Sortiert nach Opportunity Score (0-100). Hoher Score = gute Kombination aus Marge, Liquidität und Preisstabilität.">
                🏆 Opportunity @GetArrow(SortMode.Opportunity)
            </button>
            <button class="sort-btn @(_sortMode == SortMode.MarketValue ? "active" : "")"
                    @onclick="() => SetSort(SortMode.MarketValue)"
                    title="Gesamtwert aller Items dieses Typs zum aktuellen Verkaufspreis (Bestand × Sell-Preis).">
                💰 Wert @GetArrow(SortMode.MarketValue)
            </button>
            <button class="sort-btn @(_sortMode == SortMode.Profit ? "active" : "")"
                    @onclick="() => SetSort(SortMode.Profit)"
                    title="Geschätzter Netto-Gewinn nach Abzug aller Gebühren (Broker Fee + Sales Tax), basierend auf deinen Skills.">
                📈 Gewinn @GetArrow(SortMode.Profit)
            </button>
            <button class="sort-btn @(_sortMode == SortMode.Roi ? "active" : "")"
                    @onclick="() => SetSort(SortMode.Roi)"
                    title="Return on Investment: Gewinn in Prozent vom eingesetzten Kapital. ROI > 10% = gut, ROI < 0% = Verlust. Wenn Cost Basis unbekannt ist, kann kein ROI berechnet werden.">
                📊 ROI % @GetArrow(SortMode.Roi)
            </button>
            <button class="sort-btn @(_sortMode == SortMode.Quantity ? "active" : "")"
                    @onclick="() => SetSort(SortMode.Quantity)"
                    title="Anzahl der Einheiten dieses Items im Inventar.">
                📦 Menge @GetArrow(SortMode.Quantity)
            </button>
            <button class="sort-btn @(_sortMode == SortMode.Name ? "active" : "")"
                    @onclick="() => SetSort(SortMode.Name)"
                    title="Alphabetisch nach Item-Name sortiert.">
                🔤 Name @GetArrow(SortMode.Name)
            </button>
        </div>
        <div class="sort-actions">
            <span class="data-source-badge" title="@_dataSourceTooltip">@_dataSourceInfo</span>
            <button class="refresh-button" @onclick="ReloadAsync">🔄 Neu laden</button>
        </div>
    </div>

    <div class="item-list">
        @* Column headers *@
        <div class="item-list-header">
            <span class="ih-name">Item-Name</span>
            <span class="ih-qty">Menge</span>
            <span class="ih-val">Marktwert</span>
            <span class="ih-rec">Empfehlung</span>
        </div>
        @foreach (var item in _items)
        {
            <div class="item-card @GetRecClass(item.Recommendation)"  style="border-left-color: @GetRecColor(item.Recommendation);"
                 @onclick="() => ToggleDetail(item.TypeId)">
                <div class="item-row">
                    <span class="item-name" title="Klicken für Details (Preise, Kosten, ROI)">@item.TypeName</span>
                    <span class="item-qty" title="Anzahl der Einheiten dieses Items im Inventar">x @item.TotalQuantity.ToString("N0")</span>
                    <span class="item-val" title="Gesamtwert (Bestand × aktueller Sell-Preis)">@item.CurrentMarketValue.FormatIsk() ISK</span>
                    <span class="item-badge" title="@item.RecommendationReason">@GetRecBadge(item.Recommendation)</span>
                </div>

                @if (_expanded.Contains(item.TypeId))
                {
                    <div class="item-detail">
                        <div class="detail-grid">
                            <div class="dcol">
                                <div class="dlabel">Marktpreise</div>
                                <div class="drow" title='@GetPriceTooltip(item.BuyPriceSource, "Buy")'>
                                    Buy: @((item.BestBuyPrice ?? 0).FormatIsk()) ISK @GetPriceSource(item.BuyPriceSource)
                                </div>
                                <div class="drow" title='@GetPriceTooltip(item.SellPriceSource, "Sell")'>
                                    Sell: @((item.BestSellPrice ?? 0).FormatIsk()) ISK @GetPriceSource(item.SellPriceSource)
                                </div>
                                <div class="drow">Spread: @(item.SpreadPercent?.ToString("F2") ?? "N/A")%</div>
                                <div class="drow">30d Ø: @((item.AveragePrice ?? 0).FormatIsk()) ISK</div>
                                @if (item.ComparisonQuote != null)
                                {
                                    var cmp = item.ComparisonQuote;
                                    <div class="drow cmp-title" title="Frei gewählter Vergleichsmarkt (Hub-Profil): reine Bewertung — niemals ein ausführbarer Kurs für deinen Bestand. Ein Wechsel des Vergleichsmarkts lässt die Provenienz des automatischen Markt-Quotes unverändert.">
                                        🔄 Vergleich: @cmp.MarketName
                                    </div>
                                    <div class="drow-meta" title="Quelle des Vergleichs-Quotes: Markt-Snapshot = lokaler Order-Buch-Snapshot der Vergleichsmarkt-Region (mit Order-Seiten); ESI-Referenzpreis = kein Snapshot, nur der globale Referenzpreis (nie ausführbar); Unbekannt = keine Marktdaten.">
                                        Quelle: @GetComparisonQuoteSource(cmp.Source)
                                    </div>
                                    <div class="drow" title="Beste Buy-Order am Vergleichsmarkt aus dem lokalen Order-Buch-Snapshot genau dieser Region (fremde Regionspreise werden nie wiederverwendet).">
                                        Buy: @(cmp.BestBuyPrice.HasValue ? cmp.BestBuyPrice.Value.FormatIsk() : "Unbekannt") ISK
                                    </div>
                                    <div class="drow" title="Beste Sell-Order am Vergleichsmarkt aus dem lokalen Order-Buch-Snapshot genau dieser Region.">
                                        Sell: @(cmp.BestSellPrice.HasValue ? cmp.BestSellPrice.Value.FormatIsk() : "Unbekannt") ISK
                                    </div>
                                    @if (cmp.SnapshotTimestamp.HasValue)
                                    {
                                        <div class="drow-meta" title="Kumulierte Orderbuchtiefe (Buy-/Sell-Volumen) und Datenalter des Snapshots am Vergleichsmarkt. Veraltete Snapshots sind nur noch Referenz.">
                                            Tiefe B/S: @cmp.BuyVolume.ToString("N0")/@cmp.SellVolume.ToString("N0") · Alter: @((DateTime.UtcNow - cmp.SnapshotTimestamp.Value).TotalHours.ToString("F1"))h @(cmp.IsStale ? "(veraltet)" : "")
                                        </div>
                                    }
                                    @if (cmp.AveragePrice.HasValue)
                                    {
                                        <div class="drow-meta" title="ESI-Referenzpreis (adjusted/average): globaler Durchschnitt über alle Regionen — kein Order-Buch-Kurs, nie ausführbar.">
                                            Referenz (ESI): @(cmp.AveragePrice.Value.FormatIsk()) ISK — nicht ausführbar
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(cmp.Note))
                                    {
                                        <div class="drow-meta cmp-note">⚠️ @cmp.Note</div>
                                    }
                                }
                            </div>
                            <div class="dcol">
                                <div class="dlabel">Kosten</div>
                                <div class="drow" title="Durchschnittlicher Einkaufspreis pro Einheit. Quelle: Echt = Wallet-Transaktionen, Geschätzt = Marktdaten (Region-Schätzung), Manuell = selbst gesetzt, Unbekannt = kein Preis ermittelt.">
                                    Cost Basis: @(item.CostBasisPerUnit.HasValue ? $"{item.CostBasisPerUnit.Value.FormatIsk()} ISK" : "Unbekannt")
                                    @(item.CostBasisSourceLabel != null ? $"({item.CostBasisSourceLabel})" : "")
                                </div>
                                <div class="drow">Total Cost: @(item.TotalCostBasis.HasValue ? $"{item.TotalCostBasis.Value.FormatIsk()} ISK" : "N/A")</div>
                                @if (item.IsMined) { <div class="drow-meta">⛏️ Selbst abgebaut</div> }
                                @if (item.IsManufactured) { <div class="drow-meta">🏭 Selbst gebaut</div> }
                                <div class="drow">
                                    <a class="dlink" href="/costbasis" title="Zu allen offenen Einkaufspreisen (schätzen, manuell setzen, zurücksetzen)">🧾 Einkaufspreise verwalten</a>
                                </div>
                            </div>
                            <div class="dcol">
                                <div class="dlabel" title="Geschätzter Gewinn/Verlust nach Abzug von Broker Fee und Sales Tax.">Profit (nach Fees)</div>
                                <div class="drow @(item.NetRoiAfterFees >= 0 ? "green" : "red")"
                                     title="Netto-Gewinn = (Sell-Preis × Menge - Fees) - (Cost Basis × Menge).">
                                    Netto: @(item.NetProfitAfterFees.HasValue ? $"{item.NetProfitAfterFees.Value.FormatIsk()} ISK" : "N/A")
                                </div>
                                <div class="drow @(item.NetRoiAfterFees >= 0 ? "green" : "red")"
                                     title="ROI = (Netto-Gewinn / eingesetztes Kapital) × 100. Sagt dir, wie viel Prozent du auf deine Investition bekommst.">
                                    ROI: @(item.NetRoiAfterFees?.ToString("F1") ?? "N/A")%
                                </div>
                                <div class="drow" title="Opportunity Score (0-100). Kombiniert Spread, ROI, Liquidität und Preisstabilität. Über 60 = Verkauf empfohlen.">
                                    Score: @(item.OpportunityScore?.ToString("F0") ?? "N/A")/100
                                </div>
                            </div>
                        </div>
                        <div class="dreason">💡 @item.RecommendationReason</div>
                        
                        @if (item.Locations.Any())
                        {
                            <div class="loc-section">
                                <div class="dlabel" title="Ortsgebundener Handlungskontext: jede Menge wird an ihrem tatsächlichen Ort behandelt — Mengen mehrerer Orte sind nie ein stiller gemeinsamer verkaufbarer Stapel.">
                                    Orte (@item.Locations.Count)
                                </div>
                                @foreach (var loc in item.Locations)
                                {
                                    <div class="loc-row">
                                        <span class="loc-name" title="@(loc.IsMarketVenue ? "Aufgelöster Handelsplatz (Station)" : loc.SellContextBlockReason)">📍 @loc.LocationLabel</span>
                                        <span class="loc-qty">x @loc.Quantity.ToString("N0")</span>
                                        @if (!loc.IsMarketVenue)
                                        {
                                            <span class="loc-blocked" title="@loc.SellContextBlockReason">🔒 ortsgebundene Empfehlung blockiert</span>
                                        }
                                        else
                                        {
                                            <button class="loc-sell-btn" @onclick:stopPropagation="true" @onclick="() => ToggleSellSim(item, loc.LocationId)">
                                                💰 Verkauf simulieren
                                            </button>
                                        }
                                    </div>
                                }
                                @if (item.HasMultipleLocations || item.HasUnresolvedLocation)
                                {
                                    <div class="loc-note">⚠️ @item.SellContextNote</div>
                                }
                            </div>
                        }

                        <div class="detail-footer">
                            <button class="fav-button @(_favoriteTypeIds.Contains(item.TypeId) ? "is-favorite" : "")"
                                    @onclick:stopPropagation="true"
                                    @onclick="() => ToggleFavorite(item)">
                                @(_favoriteTypeIds.Contains(item.TypeId) ? "⭐ Favorit" : "⭐ Zu Favoriten")
                            </button>
                            @if (item.CanSimulateAggregate)
                            {
                                <button class="fav-button sell-sim-button"
                                        @onclick:stopPropagation="true"
                                        @onclick="() => ToggleSellSim(item)">
                                    💰 Verkauf simulieren
                                </button>
                            }
                        </div>

                        @if (_sellSimTypeId == item.TypeId)
                        {
                            var sellSimCtx = item.SellContexts.FirstOrDefault(c => c.LocationId == _sellSimLocationId);
                            @if (sellSimCtx != null)
                            {
                                <SellSimulatorView TypeId="@item.TypeId"
                                                   Quantity="@sellSimCtx.Quantity"
                                                   InitialPrice="@item.BestSellPrice"
                                                   LocationId="@sellSimCtx.LocationId"
                                                   LocationLabel="@sellSimCtx.LocationLabel" />
                            }
                        }
                    </div>
                }
            </div>
        }
    </div>
}
else
{
    <div class="no-data">
        <p>Keine Items im Inventar gefunden.</p>
        <p class="info">Stelle sicher, dass der ESI-Scope <code class="code">esi-assets.read_assets.v1</code> gesetzt ist.</p>
    </div>
}

<style>
    .portfolio-card { background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 8px; padding: 1.25rem; margin-bottom: 1rem; }
    .portfolio-stats { display: flex; gap: 1.5rem; flex-wrap: wrap; margin-bottom: 0.75rem; }
    .p-stat { text-align: center; }
    .p-label { font-size: 0.8rem; color: var(--text-secondary); display: block; }
    .p-value { font-size: 1.3rem; font-weight: bold; color: var(--text-primary); }
    .p-value.isk { color: #4a9eff; }
    .rec-bar { display: flex; gap: 0.75rem; flex-wrap: wrap; }
    .rec { padding: 0.2rem 0.6rem; border-radius: 10px; font-size: 0.8rem; }
    .rec-sell { background: rgba(76,175,80,0.15); color: #4caf50; }
    .rec-watch { background: rgba(255,193,7,0.15); color: #ffc107; }
    .rec-hold { background: rgba(244,67,54,0.15); color: #f44336; }
    .sort-controls { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem; flex-wrap: wrap; gap: 0.5rem; }
    .sort-buttons { display: flex; gap: 0.3rem; flex-wrap: wrap; }
    .sort-btn { padding: 0.35rem 0.6rem; border: 1px solid var(--border-color); border-radius: 4px; background: var(--card-bg); color: var(--text-secondary); cursor: pointer; font-size: 0.8rem; transition: all 0.15s; white-space: nowrap; }
    .sort-btn:hover { border-color: var(--primary-color); color: var(--text-primary); }
    .sort-btn.active { background: rgba(74,158,255,0.15); border-color: #4a9eff; color: #4a9eff; font-weight: 600; }
    .sort-actions { display: flex; align-items: center; gap: 0.5rem; }
    .data-source-badge { font-size: 0.75rem; color: var(--text-muted); padding: 0.2rem 0.5rem; border: 1px dashed var(--border-color); border-radius: 4px; }
    .item-list { display: flex; flex-direction: column; gap: 0.4rem; }
    .item-list-header, .item-row {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 100px 150px 130px;
        gap: 0.75rem;
        align-items: center;
    }
    .item-list-header { padding: 0.4rem 1rem; font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 1px solid var(--border-color); border-left: 4px solid transparent; }
    .ih-name { }
    .ih-qty, .item-qty { text-align: right; }
    .ih-val, .item-val { text-align: right; }
    .ih-rec, .item-badge { text-align: center; }
    .item-card { background: var(--card-bg); border: 1px solid var(--border-color); border-left: 4px solid #666; border-radius: 6px; padding: 0.75rem 1rem; cursor: pointer; transition: all 0.15s; }
    .item-card:hover { border-color: var(--primary-color); }
    .item-card.card-sell { border-left-color: #4caf50; }
    .item-card.card-watch { border-left-color: #ffc107; }
    .item-card.card-hold { border-left-color: #f44336; }
    .item-row { min-width: 0; }
    .item-name { font-weight: 600; color: var(--text-primary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .item-qty { color: var(--text-secondary); font-size: 0.85rem; }
    .item-val { font-weight: 500; color: #4a9eff; white-space: nowrap; }
    .item-badge { font-size: 0.8rem; white-space: nowrap; }
    .item-detail { margin-top: 0.75rem; padding-top: 0.75rem; border-top: 1px solid var(--border-color); }
    .detail-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 0.75rem; }
    .dlabel { font-size: 0.75rem; font-weight: 600; color: var(--text-secondary); text-transform: uppercase; margin-bottom: 0.3rem; }
    .drow { font-size: 0.85rem; color: var(--text-primary); margin-bottom: 0.2rem; }
    .drow-meta { font-size: 0.8rem; color: var(--text-secondary); font-style: italic; }
    .cmp-title { color: #4a9eff; font-weight: 600; }
    .cmp-note { color: #ffc107; }
    .dprice-source { font-size: 0.7rem; color: var(--text-muted); margin-left: 0.25rem; }
    .dlink { font-size: 0.78rem; color: var(--primary-color); text-decoration: none; }
    .dlink:hover { text-decoration: underline; }
    .green { color: #4caf50; }
    .red { color: #f44336; }
    .dreason { margin-top: 0.5rem; padding: 0.5rem; background: rgba(74,158,255,0.08); border-radius: 4px; font-size: 0.85rem; color: var(--text-secondary); }
    .loc-section { margin-top: 0.75rem; padding: 0.5rem; background: rgba(255,255,255,0.02); border: 1px solid var(--border-color); border-radius: 6px; }
    .loc-row { display: flex; align-items: center; gap: 0.6rem; padding: 0.2rem 0; font-size: 0.82rem; border-top: 1px dashed var(--border-color); }
    .loc-row:first-of-type { border-top: none; }
    .loc-name { color: var(--text-primary); flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .loc-qty { color: var(--text-secondary); text-align: right; white-space: nowrap; }
    .loc-blocked { color: #f44336; font-size: 0.75rem; white-space: nowrap; }
    .loc-sell-btn { padding: 0.25rem 0.6rem; border-radius: 4px; border: 1px solid #4caf50; background: transparent; color: #4caf50; cursor: pointer; font-size: 0.8rem; white-space: nowrap; }
    .loc-sell-btn:hover { background: rgba(76,175,80,0.12); }
    .loc-note { margin-top: 0.4rem; font-size: 0.78rem; color: #ffc107; }
    .no-data { text-align: center; padding: 2rem; color: var(--text-secondary); }
    .no-data .info { margin-top: 0.5rem; font-size: 0.85rem; color: var(--primary-color); }
    .loading { text-align: center; padding: 2rem; }
    .spinner { border: 3px solid rgba(0,0,0,0.1); border-top-color: var(--primary-color); border-radius: 50%; width: 32px; height: 32px; animation: spin 0.8s linear infinite; margin: 0 auto 0.5rem; }
    .error-banner { padding: 1rem; margin: 1rem 0; background: rgba(255,68,68,0.1); border: 1px solid rgba(255,68,68,0.3); border-radius: 6px; color: #f44; }
    @@keyframes spin { to { transform: rotate(360deg); } }
    
    .detail-footer { margin-top: 1rem; padding-top: 0.5rem; border-top: 1px solid var(--border-color); }
    .fav-button { 
        padding: 0.4rem 0.8rem; 

    .tree-unknown { margin-top: 0.4rem; border: 1px dashed var(--border-color); border-radius: 6px; padding: 0.3rem; background: rgba(255,193,7,0.04); }
</style>

@code {
    private bool _isLoading = true;
    private string? _errorMessage;
    private string _dataSourceInfo = "";
    private string _dataSourceTooltip = "";
    private PortfolioOverview? _overview;
    private List<InventoryItem> _items = new();
    private List<InventoryItem>? _allItems;
    private SortMode _sortMode = SortMode.Opportunity;
    private bool _sortAscending;
    private HashSet<int> _expanded = new();
    private int _characterId;
    private HashSet<int> _favoriteTypeIds = new();

    private HoldingsTreeResult? _holdingsTree;
    private bool _showTree;
    private HashSet<long> _expandedNodes = new();
    private HashSet<int> _expandedTypeAggs = new();

    private enum SortMode { Opportunity, MarketValue, Profit, Roi, Quantity, Name }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthService.GetAuthStateAsync();
        if (authState?.IsValid == true)
        {
            _characterId = authState.CharacterId;
            await LoadFavoritesAsync();
            await ReloadAsync();
        }
        else
        {
            _isLoading = false;
            _errorMessage = "Bitte melde dich an.";
        }
    }

    private async Task LoadFavoritesAsync()
    {
        var favorites = await MarketDataService.GetMarketFavoritsAsync(_characterId);
        if (favorites != null)
        {
            _favoriteTypeIds = favorites.Select(f => f.TypeId).ToHashSet();
        }
    }

    private async Task ToggleFavorite(InventoryItem item)
    {
        try
        {
            if (_favoriteTypeIds.Contains(item.TypeId))
            {
                var success = await MarketDataService.RemoveMarketFavoritAsync(_characterId, item.TypeId);
                if (success)
                {
                    _favoriteTypeIds.Remove(item.TypeId);
                }
            }
            else
            {
                var success = await MarketDataService.AddMarketFavoritAsync(new MarketFavorit
                {
                    CharacterId = _characterId,
                    TypeId = item.TypeId,
                    Name = item.TypeName
                });
                if (success)
                {
                    _favoriteTypeIds.Add(item.TypeId);
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error toggling favorite");
        }
    }

    private async Task ReloadAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        try
        {
            _allItems = await InventoryService.GetInventoryAsync(_characterId);
            _overview = await InventoryService.GetPortfolioOverviewAsync(_characterId);
            _holdingsTree = await HoldingsService.BuildTreeAsync(OwnerType.Character, _characterId);
            if (_allItems.Any())
            {
                var snapshotCount = _allItems.Count(i => i.BuyPriceSource == "snapshot");
                var total = _allItems.Count;
                _dataSourceInfo = snapshotCount > 0
                    ? $"📡 {snapshotCount}/{total} mit Echtzeit-Preisen"
                    : "📡 Referenzpreise (ESI)";
                _dataSourceTooltip = snapshotCount > 0
                    ? $"📡 Echtzeit-Snapshots: Nur {snapshotCount} von {total} Items werden aktiv getrackt (Mineralien + Skill Injectoren).\\nAlle anderen Items zeigen ESI-Referenzpreise (adjusted_price) — das sind von CCP berechnete globale Durchschnittspreise über alle Regionen, keine echten Order-Bücher."
                    : "📡 ESI-Referenzpreise (adjusted_price): Von CCP berechneter globaler Durchschnittspreis über alle Regionen hinweg.\\nDas ist ein theoretischer Richtwert, kein tatsächlicher Order-Buch-Kurs an einer bestimmten Station.";
            }
            ApplySort();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading inventory");
            _errorMessage = $"Fehler: {ex.Message}";
        }
        finally { _isLoading = false; }
    }

    private void SetSort(SortMode mode)
    {
        if (_sortMode == mode)
            _sortAscending = !_sortAscending;
        else
        {
            _sortMode = mode;
            _sortAscending = mode == SortMode.Name;
        }
        ApplySort();
    }

    private void ApplySort()
    {
        if (_allItems == null) return;
        var sorted = _sortMode switch
        {
            SortMode.Opportunity => _allItems.OrderBy(i => i.OpportunityScore ?? 0),
            SortMode.MarketValue => _allItems.OrderBy(i => i.CurrentMarketValue),
            SortMode.Profit => _allItems.OrderBy(i => i.NetProfitAfterFees ?? 0),
            SortMode.Roi => _allItems.OrderBy(i => i.NetRoiAfterFees ?? 0),
            SortMode.Quantity => _allItems.OrderBy(i => i.TotalQuantity),
            SortMode.Name => _allItems.OrderBy(i => i.TypeName),
            _ => _allItems.OrderBy(i => i.OpportunityScore ?? 0)
        };
        _items = _sortAscending ? sorted.ThenBy(i => i.TypeName).ToList() : sorted.ThenBy(i => i.TypeName).Reverse().ToList();
    }

    private string GetArrow(SortMode mode) => _sortMode != mode ? "" : _sortAscending ? "▲" : "▼";
    private string GetPriceSource(string? source) => source == "snapshot" ? "" : "📡";
    private string GetComparisonQuoteSource(string? source) => source switch
    {
        "market-snapshot" => "Markt-Snapshot",
        "esi-reference" => "ESI-Referenzpreis (Reference-only)",
        "unknown" => "Unbekannt",
        _ => string.Empty
    };
    private string GetPriceTooltip(string? source, string type)
    {
        if (source == "snapshot")
            return $"{type}-Preis aus dem Echtzeit-MarketDataCollector (alle 5 Min. aktualisiert).\\nGilt für die 5 Haupthandelshubs (Jita, Amarr, Dodixie, Rens, Hek).\\nDas ist ein echter Order-Buch-Kurs.";
        if (source == "reference")
            return $"{type}-Preis ist ein ESI-Referenzpreis (adjusted_price).\\nDas ist ein von CCP berechneter globaler Durchschnitt über alle Regionen — kein echter Order an einer bestimmten Station.\\n📡-Icon = Referenzpreis, kein Live-Kurs.";
        return $"{type}-Preis: Keine Daten verfügbar.";
    }

    private void ToggleDetail(int typeId)
    {
        if (_expanded.Contains(typeId)) _expanded.Remove(typeId);
        else _expanded.Add(typeId);

        if (_sellSimTypeId == typeId)
        {
            _sellSimTypeId = null; // Detail zu → Simulator schließen
            _sellSimLocationId = null;
        }
    }

    private void ToggleNode(long nodeId)
    {
        if (!_expandedNodes.Add(nodeId)) _expandedNodes.Remove(nodeId);
    }

    private void ToggleTypeAgg(int typeId)
    {
        if (!_expandedTypeAggs.Add(typeId)) _expandedTypeAggs.Remove(typeId);
    }

    private int? _sellSimTypeId;
    private long? _sellSimLocationId;

    private void ToggleSellSim(WALLEve.Services.Market.Interfaces.InventoryItem item, long? locationId = null)
    {
        // Ohne expliziten Ort nur bei GENAU EINEM aufgelösten Handelsplatz erlauben
        // (CanSimulateAggregate) — andernfalls ist der Kontext ortsgebunden.
        var target = locationId ?? (item.CanSimulateAggregate ? item.SellContexts[0].LocationId : null);

        if (_sellSimTypeId == item.TypeId && _sellSimLocationId == target)
        {
            _sellSimTypeId = null;
            _sellSimLocationId = null;
            return;
        }
        _sellSimTypeId = item.TypeId;
        _sellSimLocationId = target;
    }

    private static string GetRecBadge(string r) => r switch
    {
        "sell" => "🟢 Verkaufen",
        "watch" => "🟡 Beobachten",
        "hold" => "🔴 Halten",
        _ => "⚪"
    };

    private static string GetRecClass(string r) => r switch
    {
        "sell" => "card-sell",
        "watch" => "card-watch",
        "hold" => "card-hold",
        _ => ""
    };

    private static string GetRecColor(string r) => r switch
    {
        "sell" => "#4caf50",
        "watch" => "#ffc107",
        "hold" => "#f44336",
        _ => "#666"
    };
}

@page "/settings"
@rendermode InteractiveServer
@implements IDisposable
@using WALLEve.Configuration
@using WALLEve.Data
@using WALLEve.Models.Database
@using WALLEve.Services.Authentication.Interfaces
@using WALLEve.Services.Market.Interfaces
@inject ISdeUpdateService SdeService
@inject NavigationManager Navigation
@inject IOptions<EveOnlineSettings> EveSettings
@inject ICostBasisService CostBasisService
@inject IEveAuthenticationService AuthService
@inject ISyncOverviewService SyncOverview
@inject ISyncTriggerService SyncTrigger
@inject IBackgroundJobStatusNotifier BackgroundJobStatusNotifier
@inject WalletDbContext Db

<PageTitle>EVE Companion - Einstellungen</PageTitle>

<div class="settings-page">
    <h1>Einstellungen</h1>

    <div class="settings-section">
        <h2>📊 Static Data Export (SDE)</h2>
        <p class="section-description">
            Die SDE enthält alle statischen Spieldaten (Items, Systeme, Skills, etc.)
            und ermöglicht schnellere Abfragen ohne API-Aufrufe.
        </p>

        <div class="sde-status-card @GetStatusClass()">
            @if (_isLoading)
            {
                <div class="loading-inline">
                    <span class="spinner-small"></span>
                    <span>Prüfe Status...</span>
                </div>
            }
            else if (_status != null)
            {
                <div class="status-header">
                    <span class="status-icon">@GetStatusIcon()</span>
                    <span class="status-text">@GetStatusText()</span>
                </div>

                @if (_status.Exists)
                {
                    <div class="status-details">
                        <div class="detail-row">
                            <span class="label">Dateigröße:</span>
                            <span class="value">@_status.FileSizeFormatted</span>
                        </div>
                        <div class="detail-row">
                            <span class="label">Lokales Datum:</span>
                            <span class="value">@_status.LocalFileDate?.ToString("dd.MM.yyyy HH:mm")</span>
                        </div>
                        <div class="detail-row">
                            <span class="label">Alter:</span>
                            <span class="value @(_status.IsOutdated ? "outdated" : "")">
                                @_status.AgeDays Tage
                                @if (_status.IsOutdated)
                                {
                                    <span class="warning">(veraltet)</span>
                                }
                            </span>
                        </div>


                        @if (_status.StoredBz2Checksum != null)
                        {
                            <div class="detail-row">
                                <span class="label">Lokale Version (Hash):</span>
                                <span class="value" title="@_status.StoredBz2Checksum">@_status.StoredBz2Checksum[..12]...</span>
                            </div>
                        }
                        @if (_status.LastOnlineCheck.HasValue)
                        {
                            <div class="detail-row">
                                <span class="label">Letzte Online-Prüfung:</span>
                                <span class="value">@_status.LastOnlineCheck.Value.ToString("HH:mm:ss")</span>
                            </div>
                            @if (_status.RemoteChecksum != null)
                            {
                                <div class="detail-row">
                                    <span class="label">Online Version (Hash):</span>
                                    <span class="value" title="@_status.RemoteChecksum">@_status.RemoteChecksum[..12]...</span>
                                </div>
                            }
                            @if (_status.RemoteFileDate.HasValue)
                            {
                                <div class="detail-row">
                                    <span class="label">Online Datum:</span>
                                    <span class="value">@_status.RemoteFileDate.Value.ToString("dd.MM.yyyy HH:mm")</span>
                                </div>
                            }
                            <div class="detail-row">
                                <span class="label">Update verfügbar:</span>
                                <span class="value @(_status.UpdateAvailable ? "update-available" : "")">
                                    @(_status.UpdateAvailable ? "Ja" : "Nein")
                                </span>
                            </div>
                        }


                    </div>
                }

                @if (!string.IsNullOrEmpty(_status.ErrorMessage))
                {
                    <div class="error-message">
                        @_status.ErrorMessage
                    </div>
                }
            }
        </div>

        <div class="sde-actions">
            @if (_isDownloading)
            {
                <div class="download-progress">
                    <div class="progress-bar">
                        <div class="progress-fill" style="width: @(_downloadProgress?.ProgressPercent ?? 0)%"></div>
                    </div>
                    <div class="progress-text">
                        @(_downloadProgress?.Status ?? "Lade...")
                        @if (_downloadProgress?.TotalBytes > 0)
                        {
                            <span class="progress-percent">@_downloadProgress.ProgressPercent%</span>
                        }
                    </div>
                    <button class="button danger" @onclick="CancelDownload">
                        Abbrechen
                    </button>
                </div>
            }
            else
            {
                <button class="button" @onclick="CheckForUpdates" disabled="@_isLoading">
                    🔄 Online prüfen
                </button>

                @if (_status?.UpdateAvailable == true || !_status?.Exists == true || _status?.IsOutdated == true)
                {
                    <button class="button primary" @onclick="DownloadSde" disabled="@_isLoading">
                        ⬇️ @(_status?.Exists == true ? "Update herunterladen" : "SDE herunterladen")
                    </button>
                }
            }
        </div>

        <div class="settings-options">
            <h3>Optionen</h3>
            <div class="option-row">
                <label>
                    <span class="option-label">Maximales Alter (Tage):</span>
                    <input type="number" value="@EveSettings.Value.Sde.MaxAgeDays" min="1" max="365" disabled />
                </label>
                <span class="option-hint">Konfigurierbar in appsettings.json</span>
            </div>
            <div class="option-row">
                <span class="option-label">Beim Start auf Updates prüfen:</span>
                <span class="option-value">@(EveSettings.Value.Sde.CheckForUpdatesOnStartup ? "Ja" : "Nein")</span>
            </div>
            <div class="option-row">
                <span class="option-label">SDE beim Start erforderlich:</span>
                <span class="option-value">@(EveSettings.Value.Sde.RequireSdeForStartup ? "Ja" : "Nein")</span>
            </div>
        </div>
    </div>

    <div class="settings-section">
        <h2>🧾 Cost Basis &amp; Hintergrund-Tasks</h2>
        <p class="section-description">
            Hintergrund-Tasks (Transaktions-Spiegelung, Einkaufspreis-Ermittlung, Schätzungen)
            laufen automatisch und überleben App-Neustarts — unterbrochene Jobs werden
            an der abgebrochenen Stelle fortgesetzt.
        </p>

        <div class="settings-options">
            <h3>Standard-Schätzmarkt</h3>
            <div class="option-row">
                <span class="option-label">Referenzmarkt für Preis-Schätzungen:</span>
                <select class="btn-select" @bind="_defaultRegion" @bind:after="SaveDefaultRegionAsync">
                    @foreach (var region in CostBasisService.KnownRegions)
                    {
                        <option value="@region.Key">📍 @region.Value</option>
                    }
                </select>
                <span class="option-hint">Kann auf der Einkaufspreise-Seite pro Auswahl überschrieben werden.</span>
            </div>
        </div>

        <div class="settings-options">
            <h3>Marktdaten-Tracking</h3>
            <div class="option-row">
                <span class="option-label">Automatisch getrackte Bestands-Items (Top-N nach Marktwert):</span>
                <input type="number" class="btn-select" min="0" max="200" value="@_autoTrackTopItems"
                       @onchange="SaveAutoTrackAsync" />
                <span class="option-hint">0 = aus. Der MarketDataCollector trackt dann die wertvollsten Bestands-Items zusätzlich zu Favoriten an den 5 Handelshubs (echte Orderbuch-Preise statt Referenzpreisen).</span>
            </div>
        </div>

        @if (_syncMessage != null)
        {
            <div class="sync-message" role="status">@_syncMessage</div>
        }

        <div class="sync-overview">
            @if (_syncs == null)
            {
                <div class="loading-inline"><span class="spinner-small"></span><span>Lade Sync-Status...</span></div>
            }
            else if (!_syncs.Any())
            {
                <p class="no-jobs">Bitte zuerst anmelden, um den Sync-Status zu sehen.</p>
            }
            else
            {
                var activeSyncs = _syncs.Where(s => s.ActiveStatus != null || s.IsQueued).ToList();
                var scheduledSyncs = _syncs.Where(s => s.IsScheduled).ToList();

                <div class="sync-current-state" role="status">
                    <h3>Aktueller Status</h3>
                    @if (activeSyncs.Count == 0)
                    {
                        <p>Kein Sync läuft gerade. Die drei automatischen Syncs werden beim ersten gültigen App-Lauf und danach täglich ausgeführt.</p>
                    }
                    else
                    {
                        <ul>
                            @foreach (var sync in activeSyncs)
                            {
                                <li>
                                    <strong>@sync.Name:</strong> @GetSyncStatusText(sync)
                                    @if (sync.ActiveStatus != null && sync.ActiveTotal is > 0)
                                    {
                                        <span> · @(sync.ActiveCurrent ?? 0)/@sync.ActiveTotal</span>
                                    }
                                </li>
                            }
                        </ul>
                    }
                </div>

                <h3 class="sync-section-title">Automatische Syncs</h3>
                <p class="service-warning">Diese drei Datenquellen starten automatisch. „Noch nie“ heißt: Der erste Lauf ist noch nicht abgeschlossen.</p>
                <div class="sync-list">
                    @foreach (var sync in scheduledSyncs)
                    {
                        <div class="sync-card @(sync.ActiveStatus != null || sync.IsQueued ? "sync-running" : sync.LastError != null ? "sync-failed" : "")">
                            <div class="sync-head">
                                <strong>@sync.Name</strong>
                                <span class="sync-status @(sync.ActiveStatus != null || sync.IsQueued ? "busy" : sync.LastError != null ? "failed" : "idle")">
                                    @GetSyncStatusText(sync)
                                </span>
                            </div>
                            <div class="sync-desc">@sync.Description</div>
                            <div class="sync-meta">
                                <span>🌀 Umfang: @sync.Coverage</span>
                                <span>⏱️ Rhythmus: @sync.Frequency</span>
                            </div>

                            @if (sync.ActiveStatus != null && sync.ActiveTotal is > 0)
                            {
                                <div class="sync-progress-row">
                                    <span class="sync-progress-label">@(sync.ActiveCurrent ?? 0) / @sync.ActiveTotal</span>
                                    <div class="sync-progress-track">
                                        <div class="sync-progress-fill" style="width: @(sync.ActiveCurrent.GetValueOrDefault() * 100.0 / sync.ActiveTotal.Value)%;"></div>
                                    </div>
                                </div>
                            }

                            <div class="sync-last">
                                @if (sync.IsQueued)
                                {
                                    <span class="sync-active-text">⏳ Wird gestartet — der Collector wurde sofort geweckt.</span>
                                }
                                else if (sync.ActiveStatus != null)
                                {
                                    <span class="sync-active-text">⏳ Läuft gerade — Fortschritt wird sofort aktualisiert.</span>
                                }
                                else if (sync.LastError != null)
                                {
                                    <span class="sync-failed-text">⚠️ Zuletzt fehlgeschlagen: @FormatLocalTime(sync.LastFailedAt) — @sync.LastError</span>
                                }
                                else if (sync.LastCompletedAt.HasValue)
                                {
                                    <span>✅ Letzter Erfolg: @FormatLocalTime(sync.LastCompletedAt)</span>
                                    @if (sync.LastTotal is > 0)
                                    {
                                        <span> · @(sync.LastCurrent?.ToString() ?? "—")/@sync.LastTotal</span>
                                    }
                                }
                                else
                                {
                                    <span>⏳ Noch kein erfolgreicher Lauf — wird beim nächsten Collector-Durchlauf automatisch gestartet.</span>
                                }
                            </div>

                            @if (sync.ActiveStatus == null && !sync.IsQueued && sync.CanTrigger)
                            {
                                <button class="btn-small" @onclick="() => TriggerSyncAsync(sync.JobType)">▶️ Jetzt ausführen</button>
                            }
                        </div>
                    }
                </div>

                <p class="service-warning sync-context-note">
                    Einkaufspreis-Ermittlung startet nur bei neuen Wallet-Daten. Schätzungen und der Komplett-Scan
                    brauchen bewusst eine Auswahl bzw. einen manuellen Start auf ihren Fachseiten und werden deshalb hier nicht als überfällige Syncs angezeigt.
                </p>
            }
        </div>

        <div class="sde-actions">
            <button class="button primary" @onclick="TriggerAllScheduledSyncsAsync" disabled="@_isSyncsRefreshing">
                ▶️ Alle automatischen Syncs jetzt ausführen
            </button>
            <button class="button" @onclick="RefreshSyncsAsync" disabled="@_isSyncsRefreshing">
                @if (_isSyncsRefreshing)
                {
                    <span class="spinner-small"></span><span> Aktualisiere...</span>
                }
                else
                {
                    <span>🔄 Status aktualisieren</span>
                }
            </button>
        </div>
    </div>

    @if (_redirectAfterDownload)
    {
        <div class="redirect-notice">
            <p>Nach dem Download wirst du zur Startseite weitergeleitet.</p>
        </div>
    }
</div>

@code {
    private SdeStatus? _status;
    private SdeDownloadProgress? _downloadProgress;
    private bool _isLoading = true;
    private bool _isDownloading;
    private bool _redirectAfterDownload;
    private CancellationTokenSource? _downloadCts;

    [SupplyParameterFromQuery]
    public string? Reason { get; set; }

    protected override async Task OnInitializedAsync()
    {
        BackgroundJobStatusNotifier.StatusChanged += OnBackgroundJobStatusChanged;
        _redirectAfterDownload = Reason == "setup";
        await LoadStatus();
        await LoadSyncsAsync();
        _defaultRegion = await CostBasisService.GetDefaultEstimateRegionAsync();
    }

    // ------------------------------------------------------------------
    // Hintergrund-Tasks + Schätzmarkt
    // ------------------------------------------------------------------

    private List<CharacterSyncInfo>? _syncs;
    private int _defaultRegion = WALLEve.Services.Market.CostBasisService.DefaultRegionId;
    private int _autoTrackTopItems;
    private string? _syncMessage;
    private bool _isSyncsRefreshing;

    private async Task LoadSyncsAsync()
    {
        var auth = await AuthService.GetAuthStateAsync();
        if (auth?.IsValid == true)
        {
            _syncs = await SyncOverview.GetSyncOverviewAsync(auth.CharacterId);
        }
        else
        {
            _syncs = new List<CharacterSyncInfo>();
        }
        _autoTrackTopItems = await GetAutoTrackTopItemsAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task RefreshSyncsAsync()
    {
        _isSyncsRefreshing = true;
        _syncMessage = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            await LoadSyncsAsync();
            var activeCount = _syncs?.Count(s => s.ActiveStatus != null) ?? 0;
            var queuedCount = _syncs?.Count(s => s.IsQueued) ?? 0;
            _syncMessage = $"✅ Sync-Status aktualisiert um {DateTime.Now:HH:mm:ss}: "
                + (activeCount + queuedCount == 0
                    ? "Derzeit läuft kein Sync."
                    : $"{activeCount} läuft/laufen, {queuedCount} wird/werden gestartet.");
        }
        catch (Exception ex)
        {
            _syncMessage = $"⚠️ Sync-Status konnte nicht aktualisiert werden: {ex.Message}";
        }
        finally
        {
            _isSyncsRefreshing = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task TriggerAllScheduledSyncsAsync()
    {
        var auth = await AuthService.GetAuthStateAsync();
        if (auth?.IsValid != true)
        {
            _syncMessage = "⚠️ Bitte zuerst anmelden, um Syncs zu starten.";
            return;
        }

        var queued = await SyncTrigger.TriggerScheduledNowAsync(auth.CharacterId);
        _syncMessage = $"▶️ {queued} automatische Syncs wurden vorgemerkt. Fortschritt und Ergebnis erscheinen hier sofort.";
        await LoadSyncsAsync();
    }

    private async void OnBackgroundJobStatusChanged()
    {
        try
        {
            await InvokeAsync(LoadSyncsAsync);
        }
        catch (ObjectDisposedException)
        {
            // Circuit wurde zwischen Benachrichtigung und Dispatch beendet.
        }
    }

    public void Dispose()
    {
        BackgroundJobStatusNotifier.StatusChanged -= OnBackgroundJobStatusChanged;
    }

    private async Task<int> GetAutoTrackTopItemsAsync()
    {
        var setting = await Db.AppSettings.FindAsync("MarketData.AutoTrackTopItems");
        if (setting == null) return 0;
        return int.TryParse(setting.Value, out var limit) ? Math.Max(0, limit) : 0;
    }

    private async Task SaveAutoTrackAsync(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var limit))
        {
            limit = 0;
        }
        limit = Math.Clamp(limit, 0, 200);

        var setting = await Db.AppSettings.FindAsync("MarketData.AutoTrackTopItems");
        if (setting == null)
        {
            Db.AppSettings.Add(new AppSetting { Key = "MarketData.AutoTrackTopItems", Value = limit.ToString() });
        }
        else
        {
            setting.Value = limit.ToString();
        }
        await Db.SaveChangesAsync();
        _autoTrackTopItems = limit;
    }

    private async Task TriggerSyncAsync(string jobType)
    {
        try
        {
            var auth = await AuthService.GetAuthStateAsync();
            if (auth?.IsValid != true) return;

            var ok = await SyncTrigger.TriggerNowAsync(auth.CharacterId, jobType);
            _syncMessage = ok
                ? "▶ Sync wird gestartet. Der Collector wurde geweckt; Fortschritt und Ergebnis erscheinen hier sofort."
                : "⚠️ Dieser Sync kann derzeit nicht manuell gestartet werden.";

            await LoadSyncsAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            _syncMessage = $"Fehler: {ex.Message}";
        }
    }

    private static string GetSyncStatusText(CharacterSyncInfo s)
    {
        if (s.IsQueued) return "wird gestartet";

        return s.ActiveStatus switch
        {
        BackgroundJobStatus.Running => "läuft",
        BackgroundJobStatus.Paused => "pausiert",
        BackgroundJobStatus.Interrupted => "unterbrochen",
        _ => s.LastError != null ? "fehlgeschlagen" : "bereit"
        };
    }

    private static string FormatLocalTime(DateTime? timestamp)
    {
        if (!timestamp.HasValue) return "—";
        var utc = DateTime.SpecifyKind(timestamp.Value, DateTimeKind.Utc);
        return $"{utc.ToLocalTime():dd.MM.yyyy HH:mm} {TimeZoneInfo.Local.StandardName}";
    }

    private async Task SaveDefaultRegionAsync()
    {
        await CostBasisService.SetDefaultEstimateRegionAsync(_defaultRegion);
    }


    private async Task LoadStatus()
    {
        _isLoading = true;
        StateHasChanged();

        _status = await SdeService.GetStatusAsync(checkOnline: false);

        _isLoading = false;
        StateHasChanged();
    }

    private async Task CheckForUpdates()
    {
        _isLoading = true;
        StateHasChanged();

        _status = await SdeService.GetStatusAsync(checkOnline: true);

        _isLoading = false;
        StateHasChanged();
    }

    private async Task DownloadSde()
    {
        _isDownloading = true;
        _downloadCts = new CancellationTokenSource();

        var progress = new Progress<SdeDownloadProgress>(p =>
        {
            _downloadProgress = p;
            InvokeAsync(StateHasChanged);
        });

        try
        {
            await SdeService.DownloadAsync(progress, _downloadCts.Token);

            await LoadStatus();

            if (_redirectAfterDownload && _status?.IsValid == true)
            {
                await Task.Delay(1000); // Kurz warten damit der User "Abgeschlossen" sieht
                Navigation.NavigateTo("/");
            }
        }
        catch (OperationCanceledException)
        {
            // Abgebrochen - nichts tun
        }
        catch (Exception)
        {
            // Fehler wird über _downloadProgress angezeigt
        }
        finally
        {
            _isDownloading = false;
            _downloadCts?.Dispose();
            _downloadCts = null;
            StateHasChanged();
        }
    }

    private void CancelDownload()
    {
        _downloadCts?.Cancel();
    }

    private string GetStatusClass()
    {
        if (_status == null) return "";
        if (!_status.Exists) return "status-missing";
        if (_status.IsOutdated) return "status-outdated";
        if (_status.UpdateAvailable) return "status-update";
        return "status-ok";
    }

    private string GetStatusIcon()
    {
        if (_status == null) return "❓";
        if (!_status.Exists) return "❌";
        if (_status.IsOutdated) return "⚠️";
        if (_status.UpdateAvailable) return "🔄";
        return "✅";
    }

    private string GetStatusText()
    {
        if (_status == null) return "Unbekannt";
        if (!_status.Exists) return "SDE nicht vorhanden";
        if (_status.IsOutdated) return "SDE veraltet";
        if (_status.UpdateAvailable) return "Update verfügbar";
        return "SDE aktuell";
    }
}

<style>
    .btn-select { padding: 0.4rem 0.6rem; border: 1px solid var(--border-color); border-radius: 4px; background: var(--card-bg); color: var(--text-primary); font-size: 0.85rem; }
    .btn-small { padding: 0.2rem 0.5rem; border: 1px solid var(--border-color); border-radius: 4px; background: var(--card-bg); color: var(--text-secondary); cursor: pointer; font-size: 0.75rem; }
    .btn-small:hover { border-color: var(--primary-color); color: var(--primary-color); }
    .no-jobs { color: var(--text-muted); font-size: 0.85rem; }
    .sync-overview { margin-top: 0.5rem; }
    .sync-message { margin: 0.8rem 0; padding: 0.65rem 0.8rem; border: 1px solid rgba(74,158,255,0.4); border-radius: 6px; background: rgba(74,158,255,0.08); color: var(--text-secondary, #9aa7b5); font-size: 0.85rem; }
    .sync-current-state { margin: 0.8rem 0 1rem; padding: 0.75rem 0.9rem; border-left: 3px solid #4a9eff; background: rgba(74,158,255,0.06); }
    .sync-current-state h3, .sync-section-title { margin: 0 0 0.45rem; font-size: 0.95rem; }
    .sync-current-state p, .sync-current-state ul { margin: 0; color: var(--text-secondary, #9aa7b5); font-size: 0.84rem; line-height: 1.5; }
    .sync-current-state ul { padding-left: 1.2rem; }
    .service-warning { font-size: 0.8rem; color: var(--text-secondary, #9aa7b5); line-height: 1.5; margin-bottom: 0.8rem; }
    .sync-context-note { margin-top: 0.9rem; }
    .sync-list { display: flex; flex-direction: column; gap: 0.6rem; }
    .sync-card { background: var(--card-bg, rgba(20,28,36,0.6)); border: 1px solid var(--border-color); border-radius: 8px; padding: 0.85rem 1rem; }
    .sync-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.3rem; }
    .sync-status { font-size: 0.7rem; padding: 0.15rem 0.6rem; border-radius: 10px; text-transform: uppercase; }
    .sync-status.idle { background: rgba(76,175,80,0.15); color: #4caf50; }
    .sync-status.busy { background: rgba(255,193,7,0.15); color: #ffc107; }
    .sync-status.failed { background: rgba(244,67,54,0.15); color: #f44336; }
    .sync-desc { color: var(--text-secondary, #9aa7b5); font-size: 0.8rem; line-height: 1.4; margin-bottom: 0.4rem; }
    .sync-meta { display: flex; flex-wrap: wrap; gap: 0.75rem; font-size: 0.75rem; color: var(--text-muted, #7a8794); margin-bottom: 0.3rem; }
    .sync-last { font-size: 0.78rem; color: var(--text-secondary, #9aa7b5); }
    .sync-active-text { color: #ffc107; }
    .sync-failed-text { color: #f44336; }
    .sync-progress-row { display: flex; align-items: center; gap: 0.5rem; margin: 0.4rem 0; }
    .sync-progress-label { font-size: 0.75rem; color: var(--text-secondary, #9aa7b5); white-space: nowrap; }
    .sync-progress-track { flex: 1; height: 6px; background: rgba(255,255,255,0.08); border-radius: 3px; overflow: hidden; }
    .sync-progress-fill { height: 100%; background: #4a9eff; transition: width 0.3s; }
    .sync-card.sync-running { border-color: rgba(255,193,7,0.4); }
    .sync-card.sync-failed { border-color: rgba(244,67,54,0.5); }
</style>
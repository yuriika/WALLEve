@page "/market"
@attribute [StreamRendering]
@rendermode InteractiveServer
@inject IEsiApiService EsiApi
@inject ISdeUniverseService SdeUniverse
@inject IEveAuthenticationService AuthService
@inject ILogger<Market> Logger
@using WALLEve.Models.Esi.Markets
@using WALLEve.Models.Wallet

<PageTitle>EVE Companion - Markt</PageTitle>

<link rel="stylesheet" href="css/wallet.css" />

<div class="wallet-page">
    @if (_isLoading && _activeTab == "orders")
    {
        <div class="loading">
            <div class="spinner"></div>
            <p>Lade Marktdaten...</p>
        </div>
    }
    else if (!_isAuthenticated && _activeTab == "orders")
    {
        <div class="not-authenticated">
            <h2>Nicht angemeldet</h2>
            <p>Du musst dich anmelden, um deine Marktdaten zu sehen.</p>
            <a href="/" class="button">Zur Anmeldung</a>
        </div>
    }
    else
    {
        <div class="wallet-header">
            <h1>📊 Markt</h1>
            <div class="wallet-summary">
                <div class="summary-item">
                    <span class="label">Aktive Orders</span>
                    <span class="value">@_activeOrders.Count</span>
                </div>
            </div>
        </div>

        <!-- Tab Navigation -->
        <div class="tab-navigation">
            <button class="tab-button @(_activeTab == "orders" ? "active" : "")"
                    @onclick='() => SwitchTab("orders")'>
                📋 Meine Orders
            </button>
            <button class="tab-button @(_activeTab == "data" ? "active" : "")"
                    @onclick='() => SwitchTab("data")'>
                📈 Marktdaten
            </button>
            <button class="tab-button @(_activeTab == "finder" ? "active" : "")"
                    @onclick='() => SwitchTab("finder")'>
                🔍 Market Finder
            </button>
            <button class="tab-button @(_activeTab == "favorites" ? "active" : "")"
                    @onclick='() => SwitchTab("favorites")'>
                ⭐ Favoriten
            </button>
            <button class="tab-button @(_activeTab == "inventory" ? "active" : "")"
                    @onclick='() => SwitchTab("inventory")'>
                📦 Bestand
            </button>
        </div>

        <!-- Tab Content -->
        <div class="tab-content">
            @if (_activeTab == "orders")
            {
                <!-- Meine Orders Tab -->
                <div class="wallet-content">
                    @if (_activeOrders.Any())
                    {
                        <div class="transactions-list">
                            @foreach (var order in _activeOrders)
                            {
                                <div class="order-item @(_expandedOrderId == order.OrderId ? "expanded" : "")"
                                     @onclick="() => ToggleOrderDetails(order.OrderId)"
                                     title="Klicken für Markt-Kontext (fremde Orders, Position, Preissimulation)">
                                    <div class="order-row">
                                        <div class="order-icon">@(order.IsBuyOrder ? "📥" : "📤")</div>
                                        <div class="order-info">
                                            <div class="order-type">@(order.IsBuyOrder ? "Kauforder" : "Verkaufsorder")</div>
                                            <div class="order-name">@GetTypeName(order.TypeId)</div>
                                        </div>
                                        <div class="order-price @(order.IsBuyOrder ? "buy" : "sell")">
                                            @order.Price.FormatIsk() ISK
                                        </div>
                                        <div class="order-qty">@order.VolumeRemain / @order.VolumeTotal</div>
                                        <div class="order-hint @(_expandedOrderId == order.OrderId ? "active" : "")">
                                            📖 Markt-Kontext
                                        </div>
                                    </div>

                                    @if (_expandedOrderId == order.OrderId)
                                    {
                                        <WALLEve.Components.Market.OrderBookView OrderId="@order.OrderId" />
                                    }
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="no-transactions">
                            <p>Keine aktiven Market Orders.</p>
                        </div>
                    }

                    <div class="refresh-section">
                        <button class="refresh-button" @onclick="LoadMarketDataAsync" disabled="@_isRefreshing">
                            @if (_isRefreshing)
                            {
                                <span class="spinner-small"></span>
                                <span>Aktualisiere...</span>
                            }
                            else
                            {
                                <span>🔄 Daten aktualisieren</span>
                            }
                        </button>
                    </div>
                </div>
            }
            else if (_activeTab == "data")
            {
                <!-- Marktdaten Tab -->
                <WALLEve.Components.Market.MarketDataView />
            }
            else if (_activeTab == "finder")
            {
                <!-- Market Finder Tab -->
                <WALLEve.Components.Market.MarketFinderView />
            }
            else if (_activeTab == "favorites")
            {
                <!-- Favoriten Tab -->
                <WALLEve.Components.Market.FavoritesView />
            }
            else if (_activeTab == "inventory")
            {
                <!-- Bestand Tab -->
                <WALLEve.Components.Market.InventoryView />
            }
        </div>
    }
</div>

<style>
    .tab-navigation {
        display: flex;
        gap: 0.5rem;
        margin-bottom: 1.5rem;
        border-bottom: 2px solid var(--border-color);
        padding: 0 1rem;
    }

    .tab-button {
        padding: 0.75rem 1.5rem;
        background: none;
        border: none;
        border-bottom: 3px solid transparent;
        color: var(--text-secondary);
        cursor: pointer;
        font-size: 1rem;
        font-weight: 500;
        transition: all 0.2s;
        position: relative;
        bottom: -2px;
    }

    .tab-button:hover {
        color: var(--text-primary);
        background: rgba(255, 255, 255, 0.05);
    }

    .tab-button.active {
        color: var(--primary-color);
        border-bottom-color: var(--primary-color);
    }

    .tab-content {
        padding: 0 1rem;
    }

    .ob-toggle {
        padding: 0.35rem 0.7rem;
        border: 1px solid var(--border-color);
        border-radius: 4px;
        background: var(--card-bg);
        color: var(--text-secondary);
        cursor: pointer;
        font-size: 0.8rem;
        margin-left: 0.5rem;
        transition: all 0.15s;
        white-space: nowrap;
    }

    .order-item {
        background: var(--card-bg, rgba(20,28,36,0.6));
        border: 1px solid var(--border-color);
        border-radius: 8px;
        cursor: pointer;
        transition: border-color 0.15s, transform 0.15s;
        margin-bottom: 0.6rem;
    }
    .order-item:hover { border-color: var(--primary-color, #4a9eff); }
    .order-item.expanded { border-color: var(--primary-color, #4a9eff); }
    .order-row {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 0.85rem 1rem;
        flex-wrap: wrap;
    }
    .order-icon { font-size: 1.4rem; flex: 0 0 auto; }
    .order-info { flex: 1 1 auto; min-width: 120px; display: flex; flex-direction: column; gap: 0.2rem; }
    .order-type { font-weight: 500; color: var(--text-primary); font-size: 0.9rem; }
    .order-name { color: var(--primary-color, #4a9eff); font-size: 0.85rem; }
    .order-price { font-weight: 600; font-size: 1rem; white-space: nowrap; text-align: right; }
    .order-price.sell { color: #4caf50; }
    .order-price.buy { color: #ff9800; }
    .order-qty { color: var(--text-secondary); font-size: 0.85rem; white-space: nowrap; text-align: right; }
    .order-hint {
        padding: 0.3rem 0.7rem;
        border: 1px solid var(--border-color);
        border-radius: 4px;
        background: var(--card-bg, rgba(20,28,36,0.6));
        color: var(--text-secondary);
        font-size: 0.78rem;
        white-space: nowrap;
        transition: all 0.15s;
    }
    .order-hint.active { border-color: var(--primary-color, #4a9eff); color: var(--primary-color, #4a9eff); }
    .order-item .ob-wrapper { margin: 0 1rem 0.85rem 1rem; }
    .ob-toggle:hover, .ob-toggle.active { border-color: var(--primary-color); color: var(--primary-color); }

    .market-data-placeholder {
        padding: 2rem;
        text-align: center;
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 8px;
    }

    .market-data-placeholder h2 {
        color: var(--text-primary);
        margin-bottom: 1rem;
    }

    .market-data-placeholder ul {
        text-align: left;
        max-width: 500px;
        margin: 1rem auto;
        color: var(--text-secondary);
    }

    .market-data-placeholder .info {
        margin-top: 1.5rem;
        color: var(--primary-color);
        font-style: italic;
    }
</style>

@code {
    private bool _isLoading = true;
    private bool _isRefreshing;
    private bool _isAuthenticated;
    private List<MarketOrder> _activeOrders = new();
    private Dictionary<int, string> _typeNames = new();
    private string _activeTab = "orders";
    private long? _expandedOrderId;

    private void ToggleOrderDetails(long orderId)
    {
        _expandedOrderId = _expandedOrderId == orderId ? null : orderId;
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthService.GetAuthStateAsync();
        _isAuthenticated = authState?.IsValid == true;

        if (_isAuthenticated)
        {
            await LoadMarketDataAsync();
        }
        else
        {
            _isLoading = false;
        }
    }

    private void SwitchTab(string tabName)
    {
        _activeTab = tabName;
    }

    private async Task LoadMarketDataAsync()
    {
        if (_isRefreshing) return;

        _isRefreshing = true;
        _isLoading = true;

        try
        {
            var authState = await AuthService.GetAuthStateAsync();
            if (authState?.CharacterId == null) return;

            _activeOrders = await EsiApi.GetMarketOrdersAsync(authState.CharacterId) ?? new List<MarketOrder>();

            // Load type names
            var sdeAvailable = await SdeUniverse.IsDatabaseAvailableAsync();
            if (sdeAvailable)
            {
                foreach (var order in _activeOrders)
                {
                    if (!_typeNames.ContainsKey(order.TypeId))
                    {
                        var name = await SdeUniverse.GetTypeNameAsync(order.TypeId);
                        _typeNames[order.TypeId] = name ?? $"Type {order.TypeId}";
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading market data");
        }
        finally
        {
            _isLoading = false;
            _isRefreshing = false;
        }
    }

    private string GetTypeName(int typeId)
    {
        return _typeNames.TryGetValue(typeId, out var name) ? name : $"Type {typeId}";
    }
}

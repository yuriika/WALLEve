@page "/trading"
@attribute [StreamRendering]
@rendermode InteractiveServer
@inject WALLEve.Services.Market.Interfaces.IMarketAnalysisService MarketAnalysis
@inject WALLEve.Services.Sde.Interfaces.ISdeUniverseService SdeUniverse
@inject WALLEve.Services.Esi.Interfaces.IEsiApiService EsiApi
@inject WALLEve.Services.Authentication.Interfaces.IEveAuthenticationService AuthService
@inject WALLEve.Services.Map.Interfaces.IMapDataService MapDataService
@inject WALLEve.Services.Market.Interfaces.ICostBasisService CostBasis
@inject WALLEve.Services.Trading.Interfaces.ITradingActionCardService ActionCards
@inject ILogger<Trading> Logger
@using WALLEve.Models.Database
@using WALLEve.Models.Wallet
@using WALLEve.Components.Trading

<PageTitle>EVE Companion - Trading</PageTitle>

<link rel="stylesheet" href="css/wallet.css" />

<div class="wallet-page">
    <div class="wallet-header">
        <h1>💹 Trading</h1>
        <div class="wallet-summary">
            <div class="summary-item">
                <span class="label">Opportunities</span>
                <span class="value">@_opportunities.Count</span>
            </div>
        </div>
    </div>

    <div class="wallet-content">
        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="error-banner">
                <strong>⚠️ Fehler:</strong> @_errorMessage
                <button @onclick="() => _errorMessage = null">✕</button>
            </div>
        }

        <div class="analysis-section">
                <div class="section-header">
                    <h2>Trading Opportunities</h2>
                    <div class="filters-container">
                        <!-- Basic Filters -->
                        <div class="filters-row">
                            <label>
                                Sortieren:
                                <select @bind="_sortBy" @bind:after="SortOpportunities">
                                    <option value="score">Score</option>
                                    <option value="profit">Profit</option>
                                    <option value="timestamp">Neueste</option>
                                </select>
                            </label>
                            <label>
                                Min. Score:
                                <input type="number" @bind="_minScore" @bind:after="FilterOpportunities" min="0" max="100" step="5" />%
                            </label>
                            <label>
                                Min. Profit:
                                <input type="number" @bind="_minProfit" @bind:after="FilterOpportunities" min="0" step="100" /> ISK
                            </label>
                        </div>

                        <!-- Location Filters -->
                        <div class="filters-row location-filters">
                            <label>
                                <strong>📍 Location-Filter:</strong>
                                <select @bind="_locationFilterMode" @bind:after="OnLocationFilterChanged">
                                    <option value="all">Alle Stationen</option>
                                    <option value="current">Aktuelle Station</option>
                                    <option value="system">Aktuelles System</option>
                                    <option value="jumps">X Sprünge entfernt</option>
                                </select>
                            </label>

                            @if (_locationFilterMode == "jumps")
                            {
                                <label>
                                    Max. Sprünge:
                                    <input type="number" @bind="_maxJumps" @bind:after="OnLocationFilterChanged" min="1" max="20" step="1" />
                                </label>
                            }

                            @if (_currentLocationId.HasValue && _locationFilterMode != "all")
                            {
                                <div class="current-location-info">
                                    📌 @_currentLocationName
                                    @if (_currentSystemId.HasValue)
                                    {
                                        <span class="system-info">(@_currentSystemName)</span>
                                    }
                                </div>
                            }
                            else if (_locationFilterMode != "all")
                            {
                                <div class="location-loading">
                                    <span class="spinner-small"></span> Lade Position...
                                </div>
                            }
                        </div>
                    </div>
                </div>

                @if (_isAnalyzing)
                {
                    <div class="loading">
                        <div class="spinner"></div>
                        <p>Analysiere Marktdaten...</p>
                    </div>
                }
                else if (_filteredOpportunities.Any())
                {
                    <div class="transactions-list">
                        @foreach (var card in _cards)
                        {
                            <TradingActionCard Card="card" OnDataChanged="ReloadAfterStatusChangeAsync" />
                        }
                    </div>
                }
                else
                {
                    <div class="no-transactions">
                        <p>Keine Trading Opportunities gefunden.</p>
                        @if (_hasLoadedStats)
                        {
                            <p>
                                Die Analyse bewertet nur Bestands-Items <b>mit bekanntem Einkaufspreis</b>
                                (Cost Basis) und nur solche, bei denen der Verkauf nach Steuern/Gebühren
                                Gewinn bringt. Aktuell: <b>@_itemsWithCostBasis von @_totalItems</b> Items
                                haben einen Einkaufspreis.
                            </p>
                            @if (_itemsWithCostBasis == 0)
                            {
                                <p>👉 Pflege zuerst unter <a href="/costbasis">🧾 Einkaufspreise</a> ein paar Einkaufspreise (schätze sie per Multiselektion), dann starte die Analyse erneut.</p>
                            }
                        }
                        <p>Klicke auf "Analyse starten", um deinen Bestand jetzt zu analysieren (sonst alle 15 Minuten automatisch).</p>
                    </div>
                }
            </div>

            <div class="refresh-section">
                            <button class="refresh-button" @onclick="RunMarketAnalysisAsync" disabled="@(_isAnalyzing)">
                                @if (_isAnalyzing)
                                {
                                    <span class="spinner-small"></span>
                                    <span>Analysiere...</span>
                                }
                                else
                                {
                                    <span>🔍 Analyse starten</span>
                                }
                            </button>
                            <button class="refresh-button" @onclick="StartScanAsync" disabled="@(_isStartingScan)">
                                @if (_isStartingScan)
                                {
                                    <span>👷 Starte...</span>
                                }
                                else
                                {
                                    <span>🔁 Komplett-Scan (alle Items)</span>
                                }
                            </button>
                        </div>
                        @if (_scanMessage != null)
                        {
                            <div class="scan-message">@_scanMessage</div>
                        }
    </div>
</div>

<style>
    .analysis-section {
        margin-bottom: 2rem;
    }

    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .section-header h2 {
        margin: 0;
        color: var(--text-primary);
    }

    .filters-container {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        padding: 1rem;
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 8px;
    }

    .filters-row {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
        align-items: flex-end;
    }

    .filters-row label {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        font-size: 0.875rem;
        color: var(--text-secondary);
    }

    .filters-row select,
    .filters-row input[type="number"] {
        padding: 0.375rem 0.5rem;
        border: 1px solid var(--border-color);
        border-radius: 4px;
        background: var(--bg-color);
        color: var(--text-primary);
        font-size: 0.875rem;
        min-width: 120px;
    }

    .filters-row input[type="number"] {
        width: 100px;
    }

    .location-filters {
        padding-top: 1rem;
        border-top: 1px solid var(--border-color);
    }

    .current-location-info {
        padding: 0.5rem 1rem;
        background: rgba(0, 120, 255, 0.1);
        border: 1px solid var(--primary-color);
        border-radius: 4px;
        color: var(--text-primary);
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .current-location-info .system-info {
        color: var(--text-secondary);
        font-weight: normal;
        font-size: 0.875rem;
    }

    .location-loading {
        padding: 0.5rem 1rem;
        color: var(--text-secondary);
        font-size: 0.875rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    /* Legacy .filters class for backwards compatibility */
    .filters {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
        align-items: center;
    }

    .filters label {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        font-size: 0.875rem;
        color: var(--text-secondary);
    }

    .filters select,
    .filters input[type="number"] {
        padding: 0.375rem 0.5rem;
        border: 1px solid var(--border-color);
        border-radius: 4px;
        background: var(--card-bg);
        color: var(--text-primary);
        font-size: 0.875rem;
    }

    .filters input[type="number"] {
        width: 80px;
    }

    .error-banner {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem;
        margin-bottom: 1rem;
        background: rgba(255, 68, 68, 0.1);
        border: 1px solid rgba(255, 68, 68, 0.3);
        border-radius: 8px;
        color: #ff4444;
    }

    .error-banner button {
        background: none;
        border: none;
        color: #ff4444;
        cursor: pointer;
        font-size: 1.25rem;
        padding: 0;
        width: 24px;
        height: 24px;
    }

    .scan-message { margin-top: 0.6rem; padding: 0.5rem 0.7rem; border-radius: 4px; background: rgba(76,175,80,0.1); color: var(--text-primary, #4caf50); font-size: 0.85rem; line-height: 1.4; }

    .opportunity-meta {
        display: flex;
        gap: 1rem;
        padding: 0.5rem 1rem;
        font-size: 0.875rem;
        color: var(--text-secondary);
        border-top: 1px solid var(--border-color);
    }

    .meta-item {
        display: flex;
        align-items: center;
        gap: 0.25rem;
    }

    .meta-item.legacy-badge {
        color: #e2a336;
        font-weight: 600;
    }

    .transaction-details {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 0.25rem;
    }
</style>

@code {
    private bool _isAnalyzing;
    private bool _isStartingScan;
    private string? _scanMessage;

    private async Task StartScanAsync()
    {
        if (_isStartingScan) return;
        try
        {
            _isStartingScan = true;
            _scanMessage = null;
            var authState = await AuthService.GetAuthStateAsync();
            if (authState?.IsValid != true)
            {
                _scanMessage = "Bitte melde dich an.";
                return;
            }

            var regionId = await CostBasis.GetDefaultEstimateRegionAsync();
            var jobId = await CostBasis.StartInventoryScanAsync(authState.CharacterId, regionId);
            _scanMessage = $"✅ Komplett-Scan gestartet (Job #{jobId}). Er schätzt jetzt alle Items ohne Einkaufspreis und analysiert danach den ganzen Bestand — Fortschritt siehst du unter 🧾 Einkaufspreise oder in den Einstellungen. Die Ergebnisse erscheinen hier automatisch nach Abschluss.";
        }
        catch (InvalidOperationException ex)
        {
            _scanMessage = $"⚠️ {ex.Message}";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error starting inventory scan");
            _scanMessage = $"Fehler beim Starten des Scans: {ex.Message}";
        }
        finally
        {
            _isStartingScan = false;
        }
    }
    private string? _errorMessage;

    private List<TradingOpportunity> _opportunities = new();
    private List<TradingOpportunity> _filteredOpportunities = new();
    private List<WALLEve.Services.Trading.TradingActionCardModel> _cards = new();
    private Dictionary<int, string> _typeNames = new();
    private Dictionary<long, string> _locationNames = new();

    // Filter & Sort options
    private string _sortBy = "score";
    private double _minScore = 0;
    private double _minProfit = 0;

    // Location filter options
    private string _locationFilterMode = "all";
    private int _maxJumps = 5;
    private long? _currentLocationId;
    private int? _currentSystemId;
    private string _currentLocationName = "";
    private string _currentSystemName = "";
    private HashSet<int> _systemsWithinJumps = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadOpportunitiesAsync();
        await LoadCurrentLocationAsync();
    }

    private async Task LoadCurrentLocationAsync()
    {
        try
        {
            var authState = await AuthService.GetAuthStateAsync();
            if (authState?.CharacterId == null || authState?.IsValid != true)
                return;

            // Get current character location
            var location = await EsiApi.GetLocationAsync(authState.CharacterId);
            if (location != null)
            {
                _currentLocationId = location.StationId ?? location.StructureId;
                _currentSystemId = location.SolarSystemId;

                // Load location and system names from SDE
                var sdeAvailable = await SdeUniverse.IsDatabaseAvailableAsync();
                if (sdeAvailable && _currentLocationId.HasValue)
                {
                    _currentLocationName = await SdeUniverse.GetLocationNameAsync(_currentLocationId.Value)
                        ?? $"Location {_currentLocationId}";
                }

                if (sdeAvailable && _currentSystemId.HasValue)
                {
                    var systemInfo = await SdeUniverse.GetSolarSystemAsync(_currentSystemId.Value);
                    _currentSystemName = systemInfo?.Name ?? $"System {_currentSystemId}";
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading current location");
        }
    }

    private async Task OnLocationFilterChanged()
    {
        if (_locationFilterMode == "jumps" && _currentSystemId.HasValue)
        {
            try
            {
                // Calculate systems within jump range using Map service
                var systems = await MapDataService.GetSystemsWithinJumpsAsync(_currentSystemId.Value, _maxJumps);
                _systemsWithinJumps = systems.Select(s => s.SolarSystemId).ToHashSet();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error calculating systems within jumps");
                _systemsWithinJumps = new HashSet<int>();
            }
        }

        FilterOpportunities();
    }

    // Voller Verbindungstest inkl. Prompt-Generation entfernt (Issue #32):
    // die Trading-Seite und die Analyse benötigen keinen LLM-Server mehr.

    private int _itemsWithCostBasis;
    private int _totalItems;
    private bool _hasLoadedStats;

    private async Task LoadOpportunitiesAsync()
    {
        try
        {
            // Nur lesen! Analyse läuft nur auf expliziten Button-Klick (RunMarketAnalysisAsync)
            // oder im Hintergrund (Collector alle 15 Min), sonst erzeugt jeder Seitenaufruf
            // neue DB-Einträge.
            var authState = await AuthService.GetAuthStateAsync();
            _opportunities = await MarketAnalysis.GetActiveOpportunitiesAsync(
                authState?.IsValid == true ? authState.CharacterId : null);

            // Leer-Erklärung: warum nichts da ist (nur Items mit Cost Basis werden bewertet)
            try
            {
                if (authState?.IsValid == true)
                {
                    var items = await CostBasis.GetItemsAsync(authState.CharacterId);
                    _totalItems = items.Count;
                    _itemsWithCostBasis = items.Count(i => i.Source != CostBasisSource.None);
                    _hasLoadedStats = true;
                }
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Could not load cost basis stats for trading hint");
            }

            // Load type names and location names
            await LoadNamesAsync();
            FilterOpportunities();
            RebuildCards();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading opportunities");
        }
    }

    private async Task LoadNamesAsync()
    {
        var sdeAvailable = await SdeUniverse.IsDatabaseAvailableAsync();
        if (!sdeAvailable) return;

        foreach (var opp in _opportunities)
        {
            // Load type name
            if (!_typeNames.ContainsKey(opp.TypeId))
            {
                var name = await SdeUniverse.GetTypeNameAsync(opp.TypeId);
                _typeNames[opp.TypeId] = name ?? $"Type {opp.TypeId}";
            }

            // Load buy location name
            if (opp.BuyLocationId.HasValue && !_locationNames.ContainsKey(opp.BuyLocationId.Value))
            {
                var name = await SdeUniverse.GetLocationNameAsync(opp.BuyLocationId.Value);
                _locationNames[opp.BuyLocationId.Value] = name ?? $"Location {opp.BuyLocationId.Value}";
            }

            // Load sell location name
            if (opp.SellLocationId.HasValue && !_locationNames.ContainsKey(opp.SellLocationId.Value))
            {
                var name = await SdeUniverse.GetLocationNameAsync(opp.SellLocationId.Value);
                _locationNames[opp.SellLocationId.Value] = name ?? $"Location {opp.SellLocationId.Value}";
            }
        }
    }

    private async Task RunMarketAnalysisAsync()
    {
        if (_isAnalyzing) return;

        _isAnalyzing = true;
        try
        {
            _opportunities = await MarketAnalysis.AnalyzeMarketDataAsync();

            // Load type names and location names for new opportunities
            var sdeAvailable = await SdeUniverse.IsDatabaseAvailableAsync();
            if (sdeAvailable)
            {
                foreach (var opp in _opportunities)
                {
                    // Load type name
                    if (!_typeNames.ContainsKey(opp.TypeId))
                    {
                        var name = await SdeUniverse.GetTypeNameAsync(opp.TypeId);
                        _typeNames[opp.TypeId] = name ?? $"Type {opp.TypeId}";
                    }

                    // Load buy location name
                    if (opp.BuyLocationId.HasValue && !_locationNames.ContainsKey(opp.BuyLocationId.Value))
                    {
                        var name = await SdeUniverse.GetLocationNameAsync(opp.BuyLocationId.Value);
                        _locationNames[opp.BuyLocationId.Value] = name ?? $"Location {opp.BuyLocationId.Value}";
                    }

                    // Load sell location name
                    if (opp.SellLocationId.HasValue && !_locationNames.ContainsKey(opp.SellLocationId.Value))
                    {
                        var name = await SdeUniverse.GetLocationNameAsync(opp.SellLocationId.Value);
                        _locationNames[opp.SellLocationId.Value] = name ?? $"Location {opp.SellLocationId.Value}";
                    }
                }
            }

            FilterOpportunities();
            RebuildCards();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error running market analysis");
        }
        finally
        {
            _isAnalyzing = false;
        }
    }

    /// <summary>Nach einer Lifecycle-Markierung: Karten neu laden (Status spiegelt die Markierung).</summary>
    private async Task ReloadAfterStatusChangeAsync()
    {
        await LoadOpportunitiesAsync();
    }

    /// <summary>Karten aus den gefilterten/ sortierten Opportunities bauen (gemeinsame Engine, #66).</summary>
    private void RebuildCards()
    {
        _cards = ActionCards.BuildCards(_filteredOpportunities, _typeNames, _locationNames).ToList();
    }

    private void FilterOpportunities()
    {
        _filteredOpportunities = _opportunities
            .Where(o => o.Score >= _minScore && o.EstimatedProfit >= _minProfit)
            .Where(o => PassesLocationFilter(o))
            .ToList();

        SortOpportunities();
    }

    private bool PassesLocationFilter(TradingOpportunity opp)
    {
        switch (_locationFilterMode)
        {
            case "all":
                return true;

            case "current":
                // Filter for opportunities at current station
                if (!_currentLocationId.HasValue) return false;
                return opp.BuyLocationId == _currentLocationId || opp.SellLocationId == _currentLocationId;

            case "system":
                // Filter for opportunities in current system
                if (!_currentSystemId.HasValue) return false;
                return opp.BuySystemId == _currentSystemId || opp.SellSystemId == _currentSystemId;

            case "jumps":
                // Filter for opportunities within X jumps
                if (!_currentSystemId.HasValue || !_systemsWithinJumps.Any()) return false;

                // Check if buy or sell system is within jump range
                var buyInRange = opp.BuySystemId.HasValue && _systemsWithinJumps.Contains(opp.BuySystemId.Value);
                var sellInRange = opp.SellSystemId.HasValue && _systemsWithinJumps.Contains(opp.SellSystemId.Value);

                return buyInRange || sellInRange;

            default:
                return true;
        }
    }

    private void SortOpportunities()
    {
        _filteredOpportunities = _sortBy switch
        {
            "score" => _filteredOpportunities.OrderByDescending(o => o.Score).ToList(),
            "profit" => _filteredOpportunities.OrderByDescending(o => o.EstimatedProfit).ToList(),
            "timestamp" => _filteredOpportunities.OrderByDescending(o => o.DetectedAt).ToList(),
            _ => _filteredOpportunities
        };
    }
}

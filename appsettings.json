{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Connection": "Warning",
      "Microsoft.EntityFrameworkCore.Infrastructure": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Application": {
    "Name": "WALLEve",
    "Version": "1.0",
    "UserAgent": "WALLEve/1.0 (EVE Companion App)",
    "AppDataFolder": "WALLEve",
    "DataFolder": "Data",
    "Server": {
      "Url": "http://localhost:5080"
    }
  },
  "EveOnline": {
    "ClientId": "",
    "CallbackUrl": "http://localhost:5080/callback",
    "SsoBaseUrl": "https://login.eveonline.com/v2/oauth",
    "EsiBaseUrl": "https://esi.evetech.net/latest",
    "ImageUrls": {
      "CharacterPortrait": "https://images.evetech.net/characters/{0}/portrait",
      "CorporationLogo": "https://images.evetech.net/corporations/{0}/logo",
      "AllianceLogo": "https://images.evetech.net/alliances/{0}/logo"
    },
    "Scopes": [
      "esi-characters.read_standings.v1",
      "esi-skills.read_skills.v1",
      "esi-skills.read_skillqueue.v1",
      "esi-wallet.read_character_wallet.v1",
      "esi-wallet.read_corporation_wallets.v1",
      "esi-location.read_location.v1",
      "esi-location.read_online.v1",
      "esi-location.read_ship_type.v1",
      "esi-markets.read_character_orders.v1",
      "esi-assets.read_assets.v1",
      "esi-universe.read_structures.v1"
    ],
    "Sde": {
      "CheckForUpdatesOnStartup": true,
      "RequireSdeForStartup": true,
      "MaxAgeDays": 30,
      "DownloadUrl": "https://www.fuzzwork.co.uk/dump/latest-sqlite.db.gz",
      "ChecksumUrl": "https://www.fuzzwork.co.uk/dump/latest-sqlite.db.gz.md5sum",
      "LocalFileName": "sde.sqlite"
    },
    "Wallet": {
      "LocalFileName": "wallet.db",
      "TaxLinkingTimeWindowSeconds": 60,
      "TaxMinPercentage": 0.02,
      "TaxMaxPercentage": 0.08,
      "TaxTolerancePercentage": 0.10
    },
    "Map": {
      "CharacterTrackingIntervalSeconds": 60,
      "CharacterTrackingEnabledByDefault": true
    }
  },
  "AI": {
    "Ollama": {
      "BaseUrl": "http://localhost:11434",
      "DefaultModel": "llama3.1:latest",
      "TimeoutSeconds": 30
    }
  },
  "FeeCalculator": {
    "_comment": "Optionale manuelle Gebühren-Overrides (Issue #46). Fehlende Felder = automatische/konservative Sätze (echte ESI-Skills bzw. geschätzt). Overrides werden als 'manual_override' in der Opportunity-Historie ausgewiesen. Werte sind Dezimal-Sätze (0.02 = 2 %).",
    "BrokerFeeRate": null,
    "SalesTaxRate": null,
    "StandingsDiscount": null
  },
  "Measurement": {
    "_comment": "Issue #67: begrenzter, cachekonformer Regionalscan-Messlauf (Seiten, Bytes, Zeit, SQLite-Wachstum, Fehlerbudget). Nur bei Enabled=true — einmalig beim App-Start, kein Produktionscollector.",
    "RegionalScan": {
      "Enabled": false,
      "Regions": [10000002, 10000043, 10000032, 10000030, 10000068],
      "ProbeGzip": true
    }
  }
}
